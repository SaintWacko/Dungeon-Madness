<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 build of the main assembly. Same shared C# as 1.6/Source (the mod's top-level Source/ folder),
    compiled with RW17 defined. Output goes to 1.7/Assemblies, which LoadFolders.xml loads only on 1.7.

    1.7 runs on .NET 10, so this targets net10.0 and takes the Krafs.Rimworld.Ref 1.7 package as an ordinary
    reference, as Bastle Framework does. It has to: Bastle's 1.7 DLL is itself net10.0, and a net472 project can't
    reference it. Entad's 1.7 DLL is net472, which a net10.0 project references without trouble.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- A mod DLL is loaded by the game, not run as an app: no .deps.json beside it -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RootNamespace>DungeonMadness</RootNamespace>
    <AssemblyName>DungeonMadness</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
    <!-- Keep in step with 1.6/Source -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Dungeon Madness</Product>
    <Authors>SaintWacko</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Top level only: obj/ under Source holds generated files. -->
    <Compile Include="..\..\Source\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned: the 1.7 reference packages are prereleases, and a new one can change the API. Same version as
         Bastle and Entad, so all three compile against the same game. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4979-alpha">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Compile-only, as in 1.6/Source: the Harmony mod supplies the runtime DLL -->
    <PackageReference Include="Lib.Harmony" Version="2.4.1">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BastleFramework">
      <HintPath>..\..\..\87257f378d52\1.7\Assemblies\BastleFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntadFramework">
      <HintPath>..\..\..\EntadFramework\1.7\Assemblies\EntadFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
