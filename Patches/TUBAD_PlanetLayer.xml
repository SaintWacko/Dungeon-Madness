<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Draw dungeon icons on the planet surface. Draw order between layers comes from material render queues, not
       list order, so appending is enough and does not depend on any other entry still being there. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/PlanetLayerDef[defName="Surface"]/worldDrawLayers</xpath>
    <value>
      <li>ThisUsedToBeAboutDungeons.WorldDrawLayer_Dungeons</li>
    </value>
  </Operation>
</Patch>
