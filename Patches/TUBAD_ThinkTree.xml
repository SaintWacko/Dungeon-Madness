<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Dungeon madness: berserk's branch, with a job giver that leaves other dungeon-mad creatures alone -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThinkTreeDef[defName="MentalStateCritical"]/thinkRoot/subNodes</xpath>
    <order>Prepend</order>
    <value>
      <li Class="ThinkNode_ConditionalMentalState">
        <state>TUBAD_DungeonMadness</state>
        <subNodes>
          <li Class="ThinkNode_Priority">
            <subNodes>
              <li Class="ThisUsedToBeAboutDungeons.JobGiver_DungeonMad" />
              <li Class="JobGiver_WanderAnywhere">
                <maxDanger>Deadly</maxDanger>
              </li>
            </subNodes>
          </li>
        </subNodes>
      </li>
    </value>
  </Operation>

</Patch>
