<?xml version="1.0" encoding="UTF-8"?>
<ModMetaData>
  <name>This Used to Be About Dungeons</name>
  <packageId>saintwacko.ThisUsedToBeAboutDungeons</packageId>
  <author>saintwacko</author>
  <description>Dungeons dot the world map, each with a fixed level. Send a party of up to five into one to fight Titan creatures through themed chambers and carry out entad rewards. Every party gets a freshly generated dungeon, and each pawn can enter a given dungeon only once.</description>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>SaintWacko.EntadFramework</packageId>
      <displayName>Entad Framework</displayName>
    </li>
    <li>
      <packageId>saintwacko.TitanFramework</packageId>
      <displayName>Titan Framework</displayName>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>SaintWacko.EntadFramework</li>
    <li>saintwacko.TitanFramework</li>
    <li>SmashPhil.VehicleFramework</li>
  </loadAfter>
</ModMetaData>
