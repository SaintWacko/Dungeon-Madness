<?xml version="1.0" encoding="UTF-8"?>
<ModMetaData>
  <name>Dungeon Madness</name>
  <packageId>saintwacko.DungeonMadness</packageId>
  <author>saintwacko</author>
  <description>Dungeons dot the world map, each with a fixed level. Send a party into one to fight Bastle creatures and carry out Entad rewards. Every party gets a freshly generated dungeon, and each pawn can enter a given dungeon only once. Based on the works of Alexander Wales</description>
  <supportedVersions>
    <li>1.6</li>
    <li>1.7</li>
  </supportedVersions>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>SaintWacko.EntadFramework</packageId>
      <displayName>Entad Framework</displayName>
    </li>
    <li>
      <packageId>saintwacko.BastleFramework</packageId>
      <displayName>Bastle Framework</displayName>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>SaintWacko.EntadFramework</li>
    <li>saintwacko.BastleFramework</li>
  </loadAfter>
  <modVersion>1.0.0</modVersion>
</ModMetaData>
