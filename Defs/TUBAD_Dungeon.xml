<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- One per party inside a dungeon; destroyed with its map -->
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>TUBAD_DungeonSite</defName>
    <label>dungeon</label>
    <description>A dungeon with a party inside.</description>
    <worldObjectClass>ThisUsedToBeAboutDungeons.DungeonSite</worldObjectClass>
    <texture>World/TUBAD_Dungeon</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/TUBAD_Dungeon</expandingIconTexture>
    <expandingIconPriority>70</expandingIconPriority>
    <useDynamicDrawer>true</useDynamicDrawer>
    <isTempIncidentMapOwner>true</isTempIncidentMapOwner>
  </WorldObjectDef>

  <MapGeneratorDef>
    <defName>TUBAD_Dungeon</defName>
    <label>dungeon</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <genSteps>
      <li>TUBAD_DungeonLayout</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>TUBAD_DungeonLayout</defName>
    <order>100</order>
    <genStep Class="ThisUsedToBeAboutDungeons.GenStep_DungeonLayout" />
  </GenStepDef>

  <!-- Unbreakable: no hit points, cannot be destroyed, mined, deconstructed or targeted. Made from the tile's
       primary stone blocks only so it takes that rock's colour and name. -->
  <ThingDef ParentName="BuildingNaturalBase">
    <defName>TUBAD_DungeonWall</defName>
    <label>dungeon wall</label>
    <description>Stone that is not quite stone. Nothing scratches it: not picks, not explosives, not time.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Linked/Rock_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Rock</li>
        <li>MapEdge</li>
      </linkFlags>
    </graphicData>
    <madeFromStuff>true</madeFromStuff>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>1</costStuffCount>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <saveCompressible>true</saveCompressible>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <fertility>0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <isAirtight>true</isAirtight>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <isTargetable>false</isTargetable>
      <destroyShakeAmount>0</destroyShakeAmount>
      <supportsWallAttachments>true</supportsWallAttachments>
    </building>
  </ThingDef>

  <!-- Fills a passage between chambers. Full fill blocks sight, so the next chamber stays fogged until it is mined out. -->
  <ThingDef Name="TUBAD_PlugBase" ParentName="BuildingNaturalBase" Abstract="True">
    <thingClass>Mineable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <mineable>true</mineable>
    <useHitPoints>true</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <isAirtight>true</isAirtight>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <ThingDef ParentName="TUBAD_PlugBase">
    <defName>TUBAD_DungeonRubble</defName>
    <label>rubble</label>
    <description>Fallen stone packed into a squeeze between caverns. It can be mined out.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_Rubble</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="TUBAD_PlugBase">
    <defName>TUBAD_IcePlug</defName>
    <label>ice plug</label>
    <description>Water that seeped into a squeeze and froze solid. It can be mined out.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_IcePlug</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="TUBAD_PlugBase">
    <defName>TUBAD_RootTangle</defName>
    <label>root tangle</label>
    <description>A knot of roots grown down from the surface, thick enough to fill a squeeze between caverns. It can be hacked out with mining tools, or burned.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_RootTangle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.6</Flammability>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="TUBAD_PlugBase">
    <defName>TUBAD_SandDrift</defName>
    <label>sand drift</label>
    <description>Sand that has poured in from above and choked a squeeze between caverns. It can be dug out.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_SandDrift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="PocketMapExit">
    <defName>TUBAD_DungeonExit</defName>
    <label>dungeon exit</label>
    <description>Stairs cut into the wall, leading back up to the world. Pawns leaving climb them and rejoin the caravan waiting outside, carrying whatever they bring here.</description>
    <thingClass>ThisUsedToBeAboutDungeons.DungeonExit</thingClass>
    <size>(3,1)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TUBAD_DungeonExit</texPath>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <!-- Part of the wall: pawns walk up to it rather than onto it -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <castEdgeShadows>true</castEdgeShadows>
    <coversFloor>true</coversFloor>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(140,160,184,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
