<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- One per party inside a dungeon; destroyed with its map -->
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>TUBAD_DungeonSite</defName>
    <label>dungeon</label>
    <description>A dungeon with a party inside.</description>
    <worldObjectClass>ThisUsedToBeAboutDungeons.DungeonSite</worldObjectClass>
    <texture>World/TUBAD_Dungeon</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/TUBAD_Dungeon</expandingIconTexture>
    <expandingIconPriority>70</expandingIconPriority>
    <useDynamicDrawer>true</useDynamicDrawer>
    <isTempIncidentMapOwner>true</isTempIncidentMapOwner>
  </WorldObjectDef>

  <MapGeneratorDef>
    <defName>TUBAD_Dungeon</defName>
    <label>dungeon</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <genSteps>
      <li>TUBAD_DungeonLayout</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>TUBAD_DungeonLayout</defName>
    <order>100</order>
    <genStep Class="ThisUsedToBeAboutDungeons.GenStep_DungeonLayout" />
  </GenStepDef>

  <!-- Unbreakable: no hit points, cannot be destroyed, mined, deconstructed or targeted. Made from the tile's
       primary stone blocks only so it takes that rock's colour and name. -->
  <ThingDef ParentName="BuildingNaturalBase">
    <defName>TUBAD_DungeonWall</defName>
    <label>dungeon wall</label>
    <description>Stone that is not quite stone. Nothing scratches it: not picks, not explosives, not time.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Linked/Rock_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Rock</li>
        <li>MapEdge</li>
      </linkFlags>
    </graphicData>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>1</costStuffCount>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <!-- Not saveCompressible: compressed things reload without their stuff, so every wall would lose its stone -->
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <fertility>0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <isAirtight>true</isAirtight>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <isTargetable>false</isTargetable>
      <destroyShakeAmount>0</destroyShakeAmount>
      <supportsWallAttachments>true</supportsWallAttachments>
    </building>
  </ThingDef>

  <!-- Fills a passage between chambers. Full fill blocks sight, so the next chamber stays fogged until it is mined out. -->
  <ThingDef Name="TUBAD_PlugBase" ParentName="BuildingNaturalBase" Abstract="True">
    <thingClass>Mineable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <mineable>true</mineable>
    <useHitPoints>true</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <isAirtight>true</isAirtight>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <ThingDef ParentName="TUBAD_PlugBase">
    <defName>TUBAD_DungeonRubble</defName>
    <label>rubble</label>
    <description>Fallen stone packed into a squeeze between caverns. It can be mined out.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_Rubble</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="TUBAD_PlugBase">
    <defName>TUBAD_IcePlug</defName>
    <label>ice plug</label>
    <description>Water that seeped into a squeeze and froze solid. It can be mined out.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_IcePlug</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
    </statBases>
  </ThingDef>

  <!-- A plant rather than a mineable, so it is cleared with "cut" or "chop wood" by plant cutters and gives a
       little wood. It never grows, ages, spreads, blights or dies of darkness: the generator spawns it fully grown
       and it stays until cut or burned. Impassable like the other plugs. -->
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>TUBAD_RootTangle</defName>
    <thingClass>ThisUsedToBeAboutDungeons.Plant_RootTangle</thingClass>
    <label>root tangle</label>
    <description>A knot of roots grown down from the surface, thick enough to fill a squeeze between caverns. It can be chopped out for a little wood, or burned.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_RootTangle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <BeautyOutdoors>0</BeautyOutdoors>
    </statBases>
    <plant>
      <fertilityMin>0</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>1</growDays>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <neverBlightable>true</neverBlightable>
      <showGrowthInInspectPane>false</showGrowthInInspectPane>
      <harvestWork>600</harvestWork>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestYield>8</harvestYield>
      <harvestTag>Wood</harvestTag>
      <harvestMinGrowth>0</harvestMinGrowth>
      <harvestFailable>false</harvestFailable>
      <soundHarvesting>Harvest_Tree</soundHarvesting>
      <soundHarvestFinish>Harvest_Tree_Finish</soundHarvestFinish>
      <visualSizeRange>1~1</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <destroyedByFlooding>false</destroyedByFlooding>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
    </plant>
  </ThingDef>

  <!-- Invisible edifice under each root tangle. Plants are never edifices, and only an edifice stops the fog flood
       and line of sight, so this holds the cavern behind fogged until the tangle is cleared. The tangle destroys it
       on despawn (Plant_RootTangle). Not targetable, no hit points, nothing to select. -->
  <ThingDef ParentName="BuildingNaturalBase">
    <defName>TUBAD_TangleCore</defName>
    <label>root tangle</label>
    <description>The heart of a root tangle.</description>
    <thingClass>Building</thingClass>
    <drawerType>None</drawerType>
    <graphicData>
      <texPath>Things/Building/TUBAD_RootTangle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <selectable>false</selectable>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <isTargetable>false</isTargetable>
      <destroyShakeAmount>0</destroyShakeAmount>
    </building>
  </ThingDef>

  <ThingDef ParentName="TUBAD_PlugBase">
    <defName>TUBAD_SandDrift</defName>
    <label>sand drift</label>
    <description>Sand that has poured in from above and choked a squeeze between caverns. It can be dug out.</description>
    <graphicData>
      <texPath>Things/Building/TUBAD_SandDrift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <filthLeaving IsNull="True" />
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="PocketMapExit">
    <defName>TUBAD_DungeonExit</defName>
    <label>dungeon exit</label>
    <description>Stairs cut into the wall, leading back up to the world. Pawns leaving climb them and rejoin the caravan waiting outside, carrying whatever they bring here.</description>
    <thingClass>ThisUsedToBeAboutDungeons.DungeonExit</thingClass>
    <size>(3,1)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TUBAD_DungeonExit</texPath>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <!-- Part of the wall: pawns walk up to it rather than onto it -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <castEdgeShadows>true</castEdgeShadows>
    <coversFloor>true</coversFloor>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(140,160,184,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
