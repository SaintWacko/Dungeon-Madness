<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- One per party inside a dungeon; destroyed with its map -->
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>DMAD_DungeonSite</defName>
    <label>dungeon</label>
    <description>A dungeon with a party inside.</description>
    <worldObjectClass>DungeonMadness.DungeonSite</worldObjectClass>
    <texture>World/DMAD_Dungeon</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/DMAD_Dungeon</expandingIconTexture>
    <expandingIconPriority>70</expandingIconPriority>
    <useDynamicDrawer>true</useDynamicDrawer>
    <isTempIncidentMapOwner>true</isTempIncidentMapOwner>
  </WorldObjectDef>

  <MapGeneratorDef>
    <defName>DMAD_Dungeon</defName>
    <label>dungeon</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <genSteps>
      <li>DMAD_DungeonLayout</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>DMAD_DungeonLayout</defName>
    <order>100</order>
    <genStep Class="DungeonMadness.GenStep_DungeonLayout" />
  </GenStepDef>

  <!-- Unbreakable: no hit points, cannot be destroyed, mined, deconstructed or targeted. Made from the tile's
       primary stone blocks only so it takes that rock's colour and name. -->
  <ThingDef Name="DMAD_DungeonWallBase" ParentName="BuildingNaturalBase">
    <defName>DMAD_DungeonWall</defName>
    <label>dungeon wall</label>
    <description>Stone that is not quite stone. Nothing scratches it: not picks, not explosives, not time.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Linked/Rock_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Rock</li>
        <li>MapEdge</li>
      </linkFlags>
    </graphicData>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>1</costStuffCount>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <!-- Not saveCompressible: compressed things reload without their stuff, so every wall would lose its stone -->
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <fertility>0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <isAirtight>true</isAirtight>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <isTargetable>false</isTargetable>
      <destroyShakeAmount>0</destroyShakeAmount>
      <supportsWallAttachments>true</supportsWallAttachments>
    </building>
  </ThingDef>

  <!-- The walls of a furnished room. Each one feeds a little power into whatever is connected to it, and passes
       power along like a conduit, so the room's lights and heaters run. Nothing moved away from them keeps it. -->
  <ThingDef ParentName="DMAD_DungeonWallBase">
    <defName>DMAD_DungeonWallPowered</defName>
    <label>humming dungeon wall</label>
    <description>Dressed stone, laid by someone, with a faint warmth to it. Nothing scratches it, and anything wired to it gets power from nowhere anyone can find.</description>
    <!-- Looks built (vanilla's wall atlas in the tile's stone bricks) and still links with the rock around it -->
    <graphicData>
      <texPath>Things/Building/Linked/Wall</texPath>
      <graphicClass>Graphic_Appearances</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-60</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>

  <!-- Invisible edifice under each plant plug (a tree, bush or cactus from the dungeon's biome). Plants are never
       edifices, and only an edifice stops the fog flood and line of sight, so this holds the cavern behind fogged
       until the plant is cut, chopped, eaten or burned; it goes with the plant and keeps it from rotting in the dark
       (DungeonPlantCore). Not targetable, no hit points, nothing to select. -->
  <ThingDef ParentName="BuildingNaturalBase">
    <defName>DMAD_PlantCore</defName>
    <label>tangled growth</label>
    <description>Growth packed tight enough to fill a squeeze between caverns.</description>
    <thingClass>DungeonMadness.DungeonPlantCore</thingClass>
    <tickerType>Long</tickerType>
    <drawerType>None</drawerType>
    <graphicData>
      <texPath>Things/Building/Natural/CollapsedRocks</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <selectable>false</selectable>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <filthLeaving IsNull="True" />
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <isTargetable>false</isTargetable>
      <destroyShakeAmount>0</destroyShakeAmount>
    </building>
  </ThingDef>

  <ThingDef ParentName="PocketMapExit">
    <defName>DMAD_DungeonExit</defName>
    <label>dungeon exit</label>
    <description>Stairs cut into the wall, leading back up to the world. Pawns leaving climb them and rejoin the caravan waiting outside, carrying whatever they bring here.</description>
    <thingClass>DungeonMadness.DungeonExit</thingClass>
    <size>(3,1)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/DMAD_DungeonExit</texPath>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <!-- Part of the wall: pawns walk up to it rather than onto it -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <castEdgeShadows>true</castEdgeShadows>
    <coversFloor>true</coversFloor>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(140,160,184,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
