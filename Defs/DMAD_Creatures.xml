<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===== Dungeon-mad ===== -->

  <!-- Added to every member of a mad pack when it wakes. Keeps a person berserk (DMAD_DungeonMadness) and an animal
       manhunting for good; rules out capture and taming (DungeonMadness.cs). -->
  <HediffDef>
    <defName>DMAD_DungeonMad</defName>
    <hediffClass>DungeonMadness.Hediff_DungeonMad</hediffClass>
    <label>dungeon-mad</label>
    <description>The dungeon has its hooks in this creature's mind, and they never come out. It attacks anything that is not also dungeon-mad, and it fights on even after being downed. It cannot be captured, recruited or tamed.</description>
    <defaultLabelColor>(0.9, 0.2, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="BastleFramework.BastleSplitInherited" />
    </modExtensions>
  </HediffDef>

  <!-- Berserk that never ends, survives being downed and ignores other dungeon-mad creatures. Its think-tree branch is
       added by Patches/DMAD_ThinkTree.xml. -->
  <MentalStateDef ParentName="BaseMentalState">
    <defName>DMAD_DungeonMadness</defName>
    <stateClass>DungeonMadness.MentalState_DungeonMad</stateClass>
    <label>dungeon-mad</label>
    <category>Aggro</category>
    <blockInteractionInitiationExcept>
      <li>Insult</li>
    </blockInteractionInitiationExcept>
    <blockInteractionRecipientExcept>
      <li>Insult</li>
    </blockInteractionRecipientExcept>
    <blockRandomInteraction>true</blockRandomInteraction>
    <blockNormalThoughts>true</blockNormalThoughts>
    <nameColor>(0.9,0.2,0.5)</nameColor>
    <baseInspectLine>Mental state: Dungeon-mad</baseInspectLine>
    <stateEffecter>Berserk</stateEffecter>
    <minTicksBeforeRecovery>99999999</minTicksBeforeRecovery>
    <recoverFromSleep>false</recoverFromSleep>
    <recoverFromDowned>false</recoverFromDowned>
    <inCaravanCanDo>true</inCaravanCanDo>
  </MentalStateDef>

  <!-- ===== Dungeon dwellers: the people found in furnished rooms. No faction. -->

  <JobDef>
    <defName>DMAD_InviteDweller</defName>
    <driverClass>DungeonMadness.JobDriver_InviteDweller</driverClass>
    <reportString>inviting TargetA to leave with the party.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>DMAD_ArrestInPlace</defName>
    <driverClass>DungeonMadness.JobDriver_ArrestInPlace</driverClass>
    <reportString>arresting TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <PawnKindDef Name="DMAD_DwellerBase" Abstract="True">
    <race>Human</race>
    <isFighter>true</isFighter>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <!-- No faction to take backstories from, so the kind names them, as vanilla's wild man does -->
    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
          <li>Pirate</li>
          <li>Tribal</li>
        </categories>
      </li>
    </backstoryFilters>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <invNutrition>0</invNutrition>
    <gearHealthRange>0.3~0.8</gearHealthRange>
    <itemQuality>Poor</itemQuality>
    <apparelAllowHeadgearChance>0.3</apparelAllowHeadgearChance>
    <initialWillRange>0~1</initialWillRange>
    <initialResistanceRange>6~12</initialResistanceRange>
    <modExtensions>
      <li Class="DungeonMadness.DungeonDweller" />
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="DMAD_DwellerBase">
    <defName>DMAD_DwellerScavenger</defName>
    <label>dungeon scavenger</label>
    <combatPower>35</combatPower>
    <apparelMoney>80~250</apparelMoney>
    <apparelTags>
      <li>Neolithic</li>
      <li>IndustrialBasic</li>
    </apparelTags>
    <weaponMoney>50~200</weaponMoney>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
      <li>MedievalMeleeBasic</li>
    </weaponTags>
  </PawnKindDef>

  <PawnKindDef ParentName="DMAD_DwellerBase">
    <defName>DMAD_DwellerHunter</defName>
    <label>dungeon hunter</label>
    <combatPower>55</combatPower>
    <apparelMoney>150~400</apparelMoney>
    <apparelTags>
      <li>Neolithic</li>
      <li>IndustrialBasic</li>
    </apparelTags>
    <weaponMoney>150~400</weaponMoney>
    <weaponTags>
      <li>NeolithicRangedBasic</li>
      <li>SimpleGun</li>
    </weaponTags>
  </PawnKindDef>

  <PawnKindDef ParentName="DMAD_DwellerBase">
    <defName>DMAD_DwellerVeteran</defName>
    <label>dungeon veteran</label>
    <combatPower>90</combatPower>
    <itemQuality>Normal</itemQuality>
    <apparelMoney>400~900</apparelMoney>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialAdvanced</li>
      <li>IndustrialMilitaryBasic</li>
    </apparelTags>
    <weaponMoney>300~700</weaponMoney>
    <weaponTags>
      <li>Gun</li>
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
  </PawnKindDef>

  <!-- ===== Bastle traits ===== -->

  <!-- A waiting pack with an all-seeing member wakes as soon as any player pawn is on the map: no range, light,
       walls, smoke or invisibility (LordJob_DungeonGuard.Noticed). In Bastle's ordinary pool, but AllSeeingTraitDef
       only lets it roll on the leaders of waiting dungeon packs. Revealed when it wakes the pack on a pawn the pack
       could not otherwise have seen, while the player can see the creature. -->
  <BastleFramework.BastleTraitDef Class="DungeonMadness.AllSeeingTraitDef">
    <defName>DMAD_AllSeeing</defName>
    <label>all-seeing</label>
    <description>Nothing hides from it. Darkness, smoke, walls and even invisibility do not stop it from knowing where intruders are.</description>
    <rumor>knows where you are before you ever see it</rumor>
    <nameSuffix>the all-seeing</nameSuffix>
    <rarity>Uncommon</rarity>
    <heritable>false</heritable>
    <discoverWhen>
      <li>Manual</li>
    </discoverWhen>
  </BastleFramework.BastleTraitDef>

</Defs>
